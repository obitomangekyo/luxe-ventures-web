{
  "name": "luxe-ventures-web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write --unsafe .",
    "commit": "git add . && git-cz",
    "prepare": "[ \"$CI\" != \"true\" ] && lefthook install || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@formspree/core": "^4.0.0",
    "@formspree/react": "^3.0.0",
    "@hookform/resolvers": "^5.8.0",
    "@react-aria/numberfield": "^3.13.1",
    "@react-stately/numberfield": "^3.12.1",
    "@sentry/react": "^10.70.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-hook-form": "^7.85.0",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@netlify/vite-plugin-tanstack-start": "^1.3.17",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/router-cli": "^1.167.30",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "lefthook": "^2.1.10",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-imagetools": "^12.0.0",
    "vite-plugin-svgr": "^5.2.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.0.0",
      "onFail": "download"
    }
  }
}
